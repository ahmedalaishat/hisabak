# Anthropic key for the parse provider (console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret the app sends as `Authorization: Bearer ...`. Generate with:
#   openssl rand -hex 32
HISABAK_API_TOKEN=

# Set by rotate-token.sh to the token being retired. Both are accepted while it is set, so
# installed apps keep working until they are rebuilt. Clear it once "auth via previous token"
# stops appearing in the logs.
HISABAK_API_TOKEN_PREVIOUS=

# Optional overrides.
HISABAK_MODEL=claude-haiku-4-5
HISABAK_RATE_LIMIT_PER_MINUTE=30

# Spend guards. The bearer token ships inside the app and can be extracted, so these — not the
# token — are what bound the bill. At ~$0.0006/call, 2000/day is about $1.20/day worst case.
HISABAK_DAILY_PER_IP=200
HISABAK_DAILY_BUDGET=2000

# Host port to bind on (loopback only). Change if 8080 is taken by another app.
HISABAK_PORT=8080
